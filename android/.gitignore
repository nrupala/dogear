# Signing material — NEVER committed. The release keystore lives in the
# DOGEAR_* GitHub Actions secrets and in local custody only.
*.keystore
*.jks
*keystore-password*
*password*.txt

# Bundled web tree — generated by tools/bundle_web.py from the
# gated app build (CI restages it from the live endpoints against
# bundle-manifest.json). Never committed: 117 MB of assets do not
# belong in git history; the manifest + tool are the source.
app/src/main/assets/web/

# Machine-local + build outputs
local.properties
.gradle/
build/
app/build/
*.idsig
captures/
