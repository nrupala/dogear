{
  "action": {
    "default_icon": {
      "128": "icons/icon-128.png",
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html",
    "default_title": "DogEar \u2014 read this page"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dogear@getdogear.app",
      "strict_min_version": "121.0"
    }
  },
  "commands": {
    "read-page": {
      "description": "Read this page aloud with DogEar",
      "suggested_key": {
        "default": "Alt+Shift+R"
      }
    }
  },
  "description": "DogEar reads the page aloud in your computer's own voice \u2014 nothing is uploaded. Document in, place kept, resume anywhere.",
  "icons": {
    "128": "icons/icon-128.png",
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png"
  },
  "manifest_version": 3,
  "name": "DogEar \u2014 Read Aloud",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "version": "1.1.0"
}